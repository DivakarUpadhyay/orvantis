# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Public site URL (used for canonical URLs, sitemap, Open Graph). On Vercel it
# falls back to the production domain automatically if left unset.
NEXT_PUBLIC_SITE_URL=https://www.orvantis.tech
# Address shown on the site and used as the default sender/recipient.
NEXT_PUBLIC_CONTACT_EMAIL=hello@orvantis.tech

# ---- Contact form email (required in production) ----
# Any SMTP provider works: Resend (smtp.resend.com), Brevo, SendGrid, Zoho,
# Google Workspace (smtp.gmail.com with an App Password), Amazon SES …
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=replace-with-your-api-key
# Sender must be an address on a domain verified with your provider.
MAIL_FROM="Orvantis Technologies <no-reply@orvantis.tech>"
# Inbox that receives new enquiries.
CONTACT_TO=hello@orvantis.tech

# Local development only: write emails to .outbox/ instead of sending.
# EMAIL_TRANSPORT=file

# Max contact submissions per IP per 10 minutes (default 5).
# RATE_LIMIT_MAX=5

# ---- Search console verification (optional) ----
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Reference exchange rate used to show TWD next to INR prices (1 INR = x TWD).
# NEXT_PUBLIC_TWD_PER_INR=0.36
